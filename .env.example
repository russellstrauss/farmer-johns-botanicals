# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# For client-side (optional, if different)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Authentication (optional - defaults to 'admin'/'admin')
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=admin

# Email Configuration - Order Notifications
# Email address that will receive order notifications
ADMIN_EMAIL=admin@yourdomain.com

# For Local Development: SMTP Configuration (using nodemailer)
# Note: Wrap passwords in quotes if they contain special characters like #
SMTP_FROM=noreply@yourdomain.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD="your-smtp-password-here"

# For Production: Resend API Configuration (Cloudflare Pages)
# Get your API key from https://resend.com/api-keys
# Note: Only needed for production - local dev uses SMTP
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Note: For production deployments on Cloudflare Pages:
# - Set these same variables in Cloudflare Dashboard -> Pages Settings -> Environment Variables
# - Use RESEND_API_KEY instead of SMTP credentials for production
# - Create and bind a Workers KV namespace named "ORDERS_KV" in Pages -> Settings -> Functions -> KV Namespace Bindings
